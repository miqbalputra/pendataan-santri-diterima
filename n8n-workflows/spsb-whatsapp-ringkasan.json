                  {
                      "parameters":  {
                                         "jsCode":  "const payload = $input.first().json.body ?? $input.first().json;\nconst recipients = payload.recipients?.whatsapp ?? [];\nconst santri = payload.santri ?? {};\nconst group = payload.group ?? {};\nconst ringkasan = payload.ringkasan?.baris ?? {};\n\nfunction normalizePhone(phone) {\n  const raw = String(phone ?? \u0027\u0027).replace(/[^0-9]/g, \u0027\u0027);\n  if (raw.startsWith(\u002708\u0027)) return \u002762\u0027 + raw.slice(1);\n  if (raw.startsWith(\u00278\u0027)) return \u002762\u0027 + raw;\n  return raw;\n}\n\nfunction roleLabel(role) {\n  if (role === \u0027ibu\u0027) return \u0027Ibu\u0027;\n  if (role === \u0027wali\u0027) return \u0027Bapak/Ibu Wali\u0027;\n  return \u0027Bapak\u0027;\n}\n\nfunction groupNoticeFor(recipient) {\n  const isAkhwat = group.kelas === \u0027akhwat\u0027;\n  if (!isAkhwat) return group.aturan ?? \u0027Peserta didik putra masuk grup kelas ikhwan. Nomor WhatsApp bapak dan ibu diperbolehkan untuk masuk grup kelas ikhwan ini.\u0027;\n  if (recipient.role === \u0027ibu\u0027) return group.aturan ?? \u0027Peserta didik putri masuk grup kelas akhwat. Hanya nomor WhatsApp ibu yang diperbolehkan untuk masuk grup kelas akhwat ini.\u0027;\n  return \u0027Peserta didik putri masuk grup kelas akhwat. Link grup kelas akhwat hanya dikirim ke nomor WhatsApp ibu.\u0027;\n}\n\nfunction groupLinkFor(recipient) {\n  if (group.kelas === \u0027akhwat\u0027 \u0026\u0026 recipient.role !== \u0027ibu\u0027) return \u0027\u0027;\n  return group.link ?? \u0027\u0027;\n}\n\nconst summaryText = Object.entries(ringkasan)\n  .map(([label, value]) =\u003e `- ${label}: ${value ?? \u0027-\u0027}`)\n  .join(\u0027\\n\u0027);\n\nreturn recipients.map((recipient) =\u003e {\n  const kelasLabel = group.kelas === \u0027ikhwan\u0027 ? \u0027ikhwan (putra)\u0027 : \u0027akhwat (putri)\u0027;\n  const greeting = `${roleLabel(recipient.role)} ${recipient.name ?? \u0027\u0027}`.trim();\n  const groupLink = groupLinkFor(recipient);\n  const groupLinkText = groupLink\n    ? `Link grup: ${groupLink}`\n    : (group.kelas === \u0027akhwat\u0027 \u0026\u0026 recipient.role !== \u0027ibu\u0027 ? \u0027\u0027 : \u0027Link grup belum tersedia. Admin akan mengirimkan link menyusul.\u0027);\n  const message = `Assalamu\u0027alaikum ${greeting},\\n\\nAlhamdulillah, data pendataan SPSB untuk ananda *${santri.nama_lengkap ?? \u0027-\u0027}* sudah masuk dan diterima oleh sistem.\\n\\n*Ringkasan data:*\\n${summaryText}\\n\\n*Informasi grup kelas ${kelasLabel}:*\\n${groupNoticeFor(recipient)}\\n${groupLinkText}\\n\\nTautan lihat/cetak data pendataan:\\n${payload.links?.cetak ?? \u0027-\u0027}\\n\\nJazakumullah khairan.\\nPanitia SPSB`;\n\n  return {\n    json: {\n      phone: normalizePhone(recipient.phone),\n      role: recipient.role,\n      name: recipient.name,\n      event: \u0027pendataan_baru\u0027,\n      message,\n      payload\n    }\n  };\n});"
                                     },
